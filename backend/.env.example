# ---- LLM providers (fallback order: Groq -> OpenAI -> Gemini -> OpenRouter -> Ollama) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# check the current model name in Google AI Studio
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
# local offline model; run `ollama list` for the exact name on your laptop
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder
LLM_TIMEOUT_SECONDS=30

# ---- Security ----
# shared secret the frontend proxy sends as X-API-Key; leave empty only for local dev
APP_API_KEY=
# comma-separated exact origins, no *
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE=30/minute

# ---- Limits ----
MAX_LOG_BYTES=200000
MAX_LLM_LOG_CHARS=10000

# ---- Storage ----
DB_PATH=fixloop.db

# ---- Fix mode (agent) ----
ENABLE_FIX_MODE=true
AGENT_MAX_ATTEMPTS=3
BUILD_TIMEOUT_SECONDS=120
AUTO_APPROVE=false
